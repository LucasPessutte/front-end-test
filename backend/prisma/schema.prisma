generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Dog {
  id          String    @id @default(uuid())
  name        String
  birth_date  DateTime
  breed       String
  temperament String
  sex         String
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  @@map("dogs")
}
